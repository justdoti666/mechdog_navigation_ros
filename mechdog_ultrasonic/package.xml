<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mechdog_ultrasonic</name>
  <version>0.1.0</version>
  <description>HC-SR04 超声波阵列 ROS2 驱动包: 消息定义 + 独立 ultrasonic_node (方案A, libgpiod)</description>
  <maintainer email="justdoti666@users.noreply.github.com">justdoti666</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 消息 -->
  <depend>rosidl_default_generators</depend>

  <!-- 节点 -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <!-- N2 (2026-10-03 二轮审查复核): 修正元素顺序 —— member_of_group 必须在全部
       depend/exec_depend/test_depend 之后、export 之前 (package_format3.xsd;
       对照官方 std_msgs/rcl_interfaces)。原顺序导致 xmllint 门禁恒红。 -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
